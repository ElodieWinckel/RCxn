    <!-- https://bdlweb.phil.uni-erlangen.de/RCxn/ontologies/evid#BehavioralExperiment -->

    <owl:Class rdf:about="https://bdlweb.phil.uni-erlangen.de/RCxn/ontologies/evid#BehavioralExperiment">
