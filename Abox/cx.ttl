    cx:hasTranslation "then" ;
    rcxn:hasSlotForm cx:deuSpo_QuotativeconditionalWennSiesagenXdannY_6_Form .

cx:deuSpo_QuotativeconditionalWennSiesagenXdannY_6_Form a rcxn:SlotForm ;
    rcxn:hasSyntacticForm cx:deu_dann .

cx:deuSpo_QuotativeconditionalWennSiesagenXdannY_7 a rcxn:SlotObligatory ;
    rcxn:hasOtherSemanticContribution "suggested conclusion" ;
    rcxn:hasSlotForm cx:deuSpo_QuotativeconditionalWennSiesagenXdannY_7_Form .

cx:deuSpo_QuotativeconditionalWennSiesagenXdannY_7_Form a rcxn:SlotForm ;
    rcxn:hasSyntacticForm cx:deu_V2clauseconstruction .

cx:deuSpo_QuotativeconditionalWennSiesagenXdannY_Ex_A a cx:Example ;
    cx:hasAnnotatedText "Aber können, [wenn]2 [Sie]3 [sagen]4, [Sie wollen das jetzt raushaben]5, [dann]6 [kann man das raus, kann man den Port entfernen]7." ;
    cx:hasText "Aber können, wenn Sie sagen, Sie wollen das jetzt raushaben, dann kann man das raus, kann man den Port entfernen." ;
    cx:hasTranslation "But can, if you say, you want it out now, then it can be, the port can be removed." ;
    RDFS:comment "An example yielding deontic rights to the patient, similar to Buck & Schopf's examples, but without shift of deictic origo and directly relating to a prior utterance.." .

cx:deuSpo_QuotativeconditionalWennSiesagenXdannY_Ex_B a cx:Example ;
    cx:hasAnnotatedText "[Ich glaube Ihnen das, es ist sehr schön]7, [wenn]2 [Sie]3 [sagen]4, [es ist kleiner geworden]5." ;
    cx:hasText "Ich glaube Ihnen das, es ist sehr schön, wenn Sie sagen, es ist kleiner geworden." ;
    cx:hasTranslation "I believe you, it is very nice, if you say, it has become smaller." ;
    RDFS:comment "An example acknowledging the epistemic patient's rights, doctor indicates not to doubt observations of the patient's own body." .

cx:deuSpo_QuotativeconditionalWennSiesagenXdannY_MD a rcxn:Metadata ;
    DCTERMS:created "2026-11-02"^^xsd:date ;
    DCTERMS:references cx:deuSpo_QuotativeconditionalWennSiesagenXdannY_Sources ;
    rcxn:annotator membr:Rohwedder .

cx:deuSpo_QuotativeconditionalWennSiesagenXdannY_Meaning a rcxn:ConstructionMeaning ;
    rcxn:hasMeaning "The speaker (doctor) quotes [the listener (patient)]3 with [something they have said or may say]5, thereby assigning a stance to them that is followed up with [a suggested conclusion]7 that both interactants may relate to in the further discussion of a medical decision" .

cx:deuSpo_QuotativeconditionalWennSiesagenXdannY_Sources a dcmitype:Collection ;
    DCTERMS:hasPart references:0a5c37f9-8928-4c2e-b4fb-e85e51d134a7 .

cx:deuSpo_QuotativeconditionalWennSiesagenXdannY_slots a RDF:Seq ;
    RDF:_1 cx:deuSpo_QuotativeconditionalWennSiesagenXdannY_1 ;
    RDF:_2 cx:deuSpo_QuotativeconditionalWennSiesagenXdannY_6 ;
    RDF:_3 cx:deuSpo_QuotativeconditionalWennSiesagenXdannY_7 .

cx:deuWrSt20_sichNPADJADVvorAugenVP_1 a rcxn:SlotOptional ;
    cx:WordOrder "In most cases, NP precedes the prepositional phrase \"vor Augen\"." ;
    cx:hasIS cx:Topic ;
    evid:colloprofile ( [ frac:frequency [ a cx:CorpusX ;
                        RDF:value "39"^^xsd:int ] ;
                evid:filler "Ziel" ] [ frac:frequency [ a cx:CorpusX ;
                        RDF:value "24"^^xsd:int ] ;
                evid:filler "Bild" ] [ frac:frequency [ a cx:CorpusX ;
                        RDF:value "22"^^xsd:int ] ;
                evid:filler "Tod" ] [ frac:frequency [ a cx:CorpusX ;
                        RDF:value "16"^^xsd:int ] ;
                evid:filler "Beispiel" ] [ frac:frequency [ a cx:CorpusX ;
                        RDF:value "13"^^xsd:int ] ;
                evid:filler "Welt" ] [ frac:frequency [ a cx:CorpusX ;
                        RDF:value "12"^^xsd:int ] ;
                evid:filler "Tatsache" ] [ frac:frequency [ a cx:CorpusX ;
                        RDF:value "10"^^xsd:int ] ;
                evid:filler "Volk" ] ) ;
    rcxn:hasSemanticProperty "The NP predominantly denotes abstract concepts, particularly those that are 1) subject to mental representation (Ziel, Bild, Beispiel), 2) abstract existential element or phenomenon (Welt, Tod, Tatsache), 3) collective entities." ;
    rcxn:hasSlotForm cx:deuWrSt20_sichNPADJADVvorAugenVP_1_Form ;
    rcxn:hasSyntacticFunction "Object" .

cx:deuWrSt20_sichNPADJADVvorAugenVP_1_Form a rcxn:SlotForm ;
    rcxn:hasSyntacticForm cx:deu_NounPhrase .

cx:deuWrSt20_sichNPADJADVvorAugenVP_2 a rcxn:SlotOptional ;
    cx:WordOrder "The adjectives mostly directly precedes the prepositional phrase \"vor Augen\"." ;
    RDFS:comment "The adjectives are also frequently modified by an adverb \"so\", forming adverbial phrases such as \"so deutlich, so klar\", etc. " ;
    evid:colloprofile ( [ frac:frequency [ a cx:CorpusX ;
                        RDF:value "51"^^xsd:int ] ;
                evid:filler "deutlich" ] [ frac:frequency [ a cx:CorpusX ;
                        RDF:value "47"^^xsd:int ] ;
                evid:filler "klar" ] [ frac:frequency [ a cx:CorpusX ;
                        RDF:value "10"^^xsd:int ] ;
                evid:filler "anschaulich" ] [ frac:frequency [ a cx:CorpusX ;
                        RDF:value "9"^^xsd:int ] ;
                evid:filler "eindringlich" ] [ frac:frequency [ a cx:CorpusX ;
                        RDF:value "9"^^xsd:int ] ;
                evid:filler "lebendig" ] [ frac:frequency [ a cx:CorpusX ;
                        RDF:value "9"^^xsd:int ] ;
                evid:filler "unmittelbar" ] [ frac:frequency [ a cx:CorpusX ;
                        RDF:value "7"^^xsd:int ] ;
                evid:filler "lebhaft" ] ) ;
    rcxn:hasSemanticProperty "The adjectives share the semantic property of describing vividness or clarity." ;
    rcxn:hasSlotForm cx:deuWrSt20_sichNPADJADVvorAugenVP_2_Form .

cx:deuWrSt20_sichNPADJADVvorAugenVP_2_Form a rcxn:SlotForm ;
    rcxn:hasSyntacticForm cx:deu_Adjective .

cx:deuWrSt20_sichNPADJADVvorAugenVP_3 a rcxn:SlotOptional ;
    cx:WordOrder "The adverbs typically appear directly before the prepositional phrase \"vor Augen\"." ;
    evid:colloprofile ( [ frac:frequency [ a cx:CorpusX ;
                        RDF:value "42"^^xsd:int ] ;
                evid:filler "immer" ] [ frac:frequency [ a cx:CorpusX ;
                        RDF:value "32"^^xsd:int ] ;
                evid:filler "wieder" ] [ frac:frequency [ a cx:CorpusX ;
                        RDF:value "27"^^xsd:int ] ;
                evid:filler "stets" ] [ frac:frequency [ a cx:CorpusX ;
                        RDF:value "25"^^xsd:int ] ;
                evid:filler "noch" ] [ frac:frequency [ a cx:CorpusX ;
                        RDF:value "9"^^xsd:int ] ;
                evid:filler "täglich" ] ) ;
    rcxn:hasSemanticProperty "The adverbs share a semantic property of expressing recurrence or regularity." ;
    rcxn:hasSlotForm cx:deuWrSt20_sichNPADJADVvorAugenVP_3_Form .

cx:deuWrSt20_sichNPADJADVvorAugenVP_3_Form a rcxn:SlotForm ;
    rcxn:hasSyntacticForm cx:deu_Adverb .

cx:deuWrSt20_sichNPADJADVvorAugenVP_4 a rcxn:SlotObligatory ;
    cx:WordOrder "The preposition \"vor\" appears in direct syntactic proximity to the noun \"Augen\", forming a fixed prepositional phrase. " ;
    cx:hasIS cx:Background,
        cx:Comment ;
    cx:hasTranslation "in front of " ;
    olia:hasSemanticRole olia:LocationRole ;
    rcxn:hasSlotForm cx:deuWrSt20_sichNPADJADVvorAugenVP_4_Form ;
    rcxn:hasSyntacticFunction "Head of a prepositional phrase" .

cx:deuWrSt20_sichNPADJADVvorAugenVP_4_Form a rcxn:SlotForm ;
    rcxn:hasStem cx:deu_vor .

cx:deuWrSt20_sichNPADJADVvorAugenVP_5 a rcxn:SlotObligatory ;
    cx:WordOrder "The noun always directly follows the preposition \"vor\"." ;
    cx:hasIS cx:Background,
        cx:Comment ;
    cx:hasTranslation "eyes" ;
    rcxn:hasSemanticProperty "The noun does not refer to the literal body part but rather conveys a metaphorically extended meaning, representing perception, awareness or mental visualization." ;
    rcxn:hasSlotForm cx:deuWrSt20_sichNPADJADVvorAugenVP_5_Form ;
    rcxn:hasSyntacticFunction "Prepositional complement" .

cx:deuWrSt20_sichNPADJADVvorAugenVP_5_Form a rcxn:SlotForm ;
    rcxn:hasSurfaceForm "Augen" ;
    rcxn:hasSyntacticForm cx:deu_Noun .

cx:deuWrSt20_sichNPADJADVvorAugenVP_6 a rcxn:SlotOptional ;
    cx:WordOrder "The position of the verb within the construction is relatively flexible." ;
    cx:hasIS cx:Comment ;
    RDFS:comment "When the verb führen or halten occur, the reflexive pronoun \"sich\" is obligatory present (Element 1)." ;
    evid:colloprofile ( [ frac:frequency [ a cx:CorpusX ;
                        RDF:value "225"^^xsd:int ] ;
                evid:filler "führen" ] [ frac:frequency [ a cx:CorpusX ;
                        RDF:value "143"^^xsd:int ] ;
                evid:filler "halten" ] [ frac:frequency [ a cx:CorpusX ;
                        RDF:value "129"^^xsd:int ] ;
                evid:filler "haben" ] [ frac:frequency [ a cx:CorpusX ;
                        RDF:value "25"^^xsd:int ] ;
                evid:filler "stellen" ] [ frac:frequency [ a cx:CorpusX ;
                        RDF:value "15"^^xsd:int ] ;
                evid:filler "stehen" ] ) ;
    rcxn:hasSemanticProperty "Though these verbs are highly polysemous, they either relate to the positioning of something in space, either actively (führen, stellen) or passively (stehen), or imply control or possession (halten, haben, führen)" ;
    rcxn:hasSlotForm cx:deuWrSt20_sichNPADJADVvorAugenVP_6_Form .

cx:deuWrSt20_sichNPADJADVvorAugenVP_6_Form a rcxn:SlotForm ;
    rcxn:hasSyntacticForm cx:deu_Verb .

cx:deuWrSt20_sichNPADJADVvorAugenVP_MD a rcxn:Metadata ;
    DCTERMS:created "2024-12-02"^^xsd:date ;
    rcxn:annotator membr:Lee .

cx:deuWrSt20_sichNPADJADVvorAugenVP_Meaning a rcxn:ConstructionMeaning ;
    rcxn:hasMeaning "The construction denotes a cognitive process involving the act of bringing something into focus or visualizing it mentally, including introspection, planning and imaginative conceptualization." .

