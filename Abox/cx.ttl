cx:gmh12C_PräfixverbkonstruktionTätigkeit_Ex_A a cx:Example ;
    cx:hasAnnotatedText "[ich]1 [durc]2 [ginc]3 in miner unſculde hercē mineſ in mitten huſeſ mineſ [TP h/55va,6]" ;
    cx:hasGlosses "I through went in my innocence heart's mine in middle house's mine" ;
    cx:hasText "ich durc ginc in miner unſculde hercē mineſ in mitten huſeſ mineſ [TP h/55va,6]" ;
    cx:hasTranslation "I strolled through the inside of my house in my heart's complete innocence" ;
    cx:hasTransliteration "ich durc ginc in miner unschulde herce mines in mitten huses mines" ;
    RDFS:comment "Source: Trierer Interlinearversion zum Psalter: 55va,6; see https://www.linguistics.rub.de/rem/pub/texts//M188_dipl.pdf" .

