cx:deuSpo_QuotativeconditionalWennSiesagenXdannY_5 a rcxn:SlotObligatory ;
    cx:WordOrder "between object 4 and 6" ;
    olia:hasSemanticRole olia:ObliqueRole ;
    rcxn:hasOtherSemanticContribution "(actual or fictitious) quote of the adressee" ;
    rcxn:hasSlotForm cx:deuSpo_QuotativeconditionalWennSiesagenXdannY_5_Form ;
