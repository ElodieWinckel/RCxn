cx:eng_alotofPLUSNconstruction_1 a rcxn:SlotObligatory ;
    cx:WordOrder "Precedes Element 2" ;
    RDFS:comment "Fixed article forming part of the complex quantifier a lot of" ;
    rcxn:hasSlotForm cx:eng_alotofPLUSNconstruction_1_Form ;
    rcxn:hasSyntacticFunction "Determiner" .

cx:eng_alotofPLUSNconstruction_1_Form a rcxn:SlotForm ;
    rcxn:hasStem cx:eng_a ;
    rcxn:hasSurfaceForm "a" ;
    rcxn:hasSyntacticForm cx:eng_Indefinitearticle .

cx:eng_alotofPLUSNconstruction_2 a rcxn:SlotObligatory ;
    cx:WordOrder "Follows element 1 and precedes element 3" ;
    RDFS:comment "Historically a lexical noun, lot forms part of a grammaticalized quantifier in this construction. Its earlier source meaning is no longer central to the quantificational reading" ;
    rcxn:hasSlotForm cx:eng_alotofPLUSNconstruction_2_Form ;
    rcxn:hasSyntacticFunction "Noun-derived component of the complex binominal quantifier" .

cx:eng_alotofPLUSNconstruction_2_Form a rcxn:SlotForm ;
    rcxn:hasPhonology "lot" ;
    rcxn:hasStem cx:eng_lot ;
    rcxn:hasSyntacticForm cx:eng_Noun .

cx:eng_alotofPLUSNconstruction_3 a rcxn:SlotObligatory ;
    cx:WordOrder "Follows element 2 and precedes element 4" ;
    RDFS:comment "Fixed linking element connecting the complex quantifier to the quantified nominal expression" ;
    rcxn:hasSlotForm cx:eng_alotofPLUSNconstruction_3_Form ;
    rcxn:hasSyntacticFunction "Partitive" .

cx:eng_alotofPLUSNconstruction_3_Form a rcxn:SlotForm ;
    rcxn:hasStem cx:eng_of ;
    rcxn:hasSurfaceForm "of" ;
    rcxn:hasSyntacticForm cx:eng_Preposition .

cx:eng_alotofPLUSNconstruction_4 a rcxn:SlotObligatory ;
    cx:WordOrder "Follows element 3" ;
    RDFS:comment "Open nominal slot that can be filled by plural count nouns, mass nouns, or pronouns. Internal modification is permitted, e.g., a lot of difficult questions" ;
    rcxn:hasOtherSemanticContribution "Identifies the entities being quantified." ;
    rcxn:hasSemanticProperty "Plural count, mass, or pronominal referent" ;
    rcxn:hasSlotForm cx:eng_alotofPLUSNconstruction_4_Form ;
    rcxn:hasSyntacticFunction "Quantified nominal expression" .

cx:eng_alotofPLUSNconstruction_4_Form a rcxn:SlotForm ;
    rcxn:hasSyntacticForm cx:eng_NounPhrase .

cx:eng_alotofPLUSNconstruction_Ex_A a cx:Example ;
    cx:hasAnnotatedText "[A]1 [lot]2 [of]3 [them]4 had purchased a site for a town ..." ;
    cx:hasText "A lot of them had purchased a site for a town ..." ;
    RDFS:comment "ARCHER, 1863 (Text_ID: 1863twn__x6a).",
        "The quantifier takes a pronominal complement." .

cx:eng_alotofPLUSNconstruction_Ex_B a cx:Example ;
    cx:hasAnnotatedText "“When I make a word do [a]1 [lot]2 [of]3 [work]4 like that,” said Humpty Dumpty, ..." ;
    cx:hasText "“When I make a word do a lot of work like that,” said Humpty Dumpty, ..." ;
    RDFS:comment "CLMET, 1871. Lewis Carroll, Through the Looking-Glass (Text_ID: CLMET3_1_3_222).",
        "Quantification of a mass noun." .

cx:eng_alotofPLUSNconstruction_Ex_C a cx:Example ;
    cx:hasAnnotatedText "In New York, [a]1 [lot]2 [of]3 [people]4 brought great big family Bibles that they could hardly carry." ;
    cx:hasText "In New York, a lot of people brought great big family Bibles that they could hardly carry." ;
    RDFS:comment "ARCHER, 1958. Billy Graham, Christ's Answer to the World (Text_ID: 1958grah_h8a).",
        "Quantification of a plural count noun referring to people." .

cx:eng_alotofPLUSNconstruction_MD a rcxn:Metadata ;
    DCTERMS:created "2026-10-19"^^xsd:date ;
    DCTERMS:references cx:eng_alotofPLUSNconstruction_Sources ;
    rcxn:annotator membr:Khanoub .

cx:eng_alotofPLUSNconstruction_Meaning a rcxn:ConstructionMeaning ;
    rcxn:hasMeaning "The construction expresses a contextually large, unspecified number or amount. It can quantify plural count nouns (a lot of people) and mass nouns (a lot of water). In this use, a lot of functions as a complex quantifier rather than referring to a literal/source lot, parcel, or portion." .

