cx:gmh12C_PräfixverbkonstruktionlokalistischeTätigkeit_Ex_A a cx:Example ;
    cx:hasAnnotatedText "[Wir]1 [durch]2 [furen]3 [durch daz fur un̄ daz wazer]4 " ;
