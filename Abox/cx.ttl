cx:deuSpo_QuotativeconditionalWennSiesagenXdannY_4 a rcxn:SlotObligatory ;
    cx:WordOrder "between elements 3 and 5, but adjuncts can go in between on either side" ;
    cx:hasIndex cx:deuSpo_QuotativeconditionalWennSiesagenXdannY_4_Index ;
