    rsrch:hasFindings membr:Project_Boos_2611051416_F2611051416 ;
    rsrch:projectName "Which factors influence relative clause interpretation, especially object relative clause processing?" .

membr:Project_Boos_2611051450 a rsrch:Project ;
    rsrch:hasFindings membr:Project_Boos_2611051450_F2611051450 ;
    rsrch:projectName "Which factors influence relative clause interpretation, especially object relative clause processing?" .

