membr:Project_Trombetta a rsrch:Project ;
    rsrch:hasFindings membr:Project_Trombetta_F250218 ;
    rsrch:projectName "Constructions beyond the sentence: text-structuring in (esp.) sixteenth-century historiographical texts"@en .

membr:Project_Trombetta_F250218 a rsrch:Finding ;
    RDFS:label "The text reveals various types of text-level constructions, i.e., constructions capable of structuring and organizing the text. These structures, while formally appearing as sentences or phrases, operate at the textual level." ;
    rsrch:basedOn cx:itaStoria_RelativeTopicShiftConstruction .

membr:Project_Tzimas a rsrch:Project ;
    rsrch:projectName "Subject-inversion throughout Early Modern English: changing relations in individual and communal constructions"@en .

