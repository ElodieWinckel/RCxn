    rsrch:projectName "Building a Research Constructicon"@en .

membr:Project_Winckel_2601131454_F2601131454 a rsrch:Finding ;
    RDFS:label "The relational database for CASA entries can be translated into the RDF format of the Research Constructicon." ;
    rsrch:basedOn cx:engLME_AttributeConstructionAttrAdj,
        cx:eng_GenitiveNPConstruction,
        cx:eng_ditransitive_construction_obj_np,
        cx:lat_Adjective .

membr:Project_Winckel_F2511281100 a rsrch:Finding ;
    RDFS:label "Implement a lexical item in the research constructicon" ;
    rsrch:basedOn cx:_coolconstruction,
        cx:engInf_Coolexclamativeconstruction,
        cx:eng_AdjectiveAttributiveconstruction,
        cx:eng_AdjectivePhrase,
        cx:eng_AdjectivePredicativeconstruction,
        cx:eng_Keepacoolheadconstruction,
        cx:eng_coolconstruction .

