    rsrch:projectName "What role does umlaut play in forming plural constructions in dialects?" .

membr:Project_Khanoub_2610141629 a rsrch:Project ;
    rsrch:hasFindings membr:Project_Khanoub_2610141629_F2610141629_A,
        membr:Project_Khanoub_2610141629_F2610141629_B ;
    rsrch:projectName "How does the [many + Ncount] construction participate in diachronic quantifier competition, and which linguistic properties distinguish its use from that of binominal quantifiers such as [Det + lot + of + N]?" .

membr:Project_Khanoub_2610191625 a rsrch:Project ;
