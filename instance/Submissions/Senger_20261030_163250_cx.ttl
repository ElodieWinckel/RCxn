membr:Project_Senger rsrch:hasResearchQuestion membr:Project_Senger_2610301632 .

cx:engUsSpo_XissoNP a rcxn:Construction ;
    cx:hasExample cx:engUsSpo_XissoNP_Ex_A,
        cx:engUsSpo_XissoNP_Ex_B ;
    cx:hasIntonation "The modifier must receive the highest pitch accent (Gaston 2011) " ;
    lg:partOfLanguage lg:engUsSpo ;
    rcxn:hasConstructionMeaning cx:engUsSpo_XissoNP_Meaning ;
    rcxn:hasMetadata cx:engUsSpo_XissoNP_MD ;
    rcxn:hasSlots cx:engUsSpo_XissoNP_slots ;
    rcxn:hasTitle "X is so NP" .

cx:engUsSpo_XissoNP_1 a rcxn:SlotObligatory ;
    cx:WordOrder "precedes element 2" ;
    olia:hasSemanticRole olia:ThemeRole ;
    rcxn:hasSyntacticFunction "Subject" .

cx:engUsSpo_XissoNP_2 a rcxn:SlotObligatory ;
    cx:WordOrder "follows element 1, precedes element 3" ;
    rcxn:hasSlotForm cx:engUsSpo_XissoNP_1_Form ;
    cx:hasIndex cx:engUsSpo_XissoNP_2_Index .

cx:engUsSpo_XissoNP_1_Form a rcxn:SlotForm ;
    rcxn:hasSurfaceForm "so" .

cx:engUsSpo_XissoNP_2_Index a cx:Event ;
    olia:hasTense olia:NotTemporallyAnchored .

cx:engUsSpo_XissoNP_3 a rcxn:SlotObligatory ;
    cx:WordOrder "follows element 2, precedes element 4" ;
    rcxn:hasSyntacticFunction "Modifier" .

cx:engUsSpo_XissoNP_4 a rcxn:SlotObligatory ;
    cx:WordOrder "follows element 4" ;
    RDFS:comment "Behaves as a gradient category between noun and adjective (Gonzálvez-García 2014: 279)" ;
    rcxn:hasSyntacticFunction "Object" ;
    rcxn:hasSlotForm cx:engUsSpo_XissoNP_4_Form.

cx:engUsSpo_XissoNP_4_Form a rcxn:SlotForm ;
    rcxn:hasSyntacticForm cx:eng_NounPhrase .

cx:engUsSpo_XissoNP_Ex_A a cx:Example ;
    cx:hasAnnotatedText "I love it! [It]1 [’s]2 [so]3 [college]4. " ;
    cx:hasText "I love it! It ’s so college. " ;
    RDFS:comment "(Live with Regis and Kelly, KABC, 2009-08-06)" .

cx:engUsSpo_XissoNP_Ex_B a cx:Example ;
    cx:hasAnnotatedText "[You]1 [’re]2 [so]3 [glass half full today]4. " ;
    cx:hasText "You ’re so glass half full today. " ;
    RDFS:comment "(Live with Regis and Kelly, KABC, 2009-10-19)" .

