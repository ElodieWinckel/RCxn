cx:arzCai_Ditransitiveconstruction_1 a rcxn:SlotOptional ;
    cx:WordOrder "Before element 2" ;
    olia:hasSemanticRole olia:AgentRole .

cx:arzCai_Ditransitiveconstruction_2 a rcxn:SlotObligatory ;
    cx:WordOrder "After element 2, before elements 3 and 4" ;
    RDFS:comment "colloprofile: idda; ʿallim; nāwil; massik; sallif; labbis; sallim; ḥammil; darris; šammim; fahhim; ḥaffaẓ; nassa; ballaġ; saʾal; fahhim; malla; warra; ḫassaṛ; ġaṛṛam; ʾallaʿ" .

cx:arzCai_Ditransitiveconstruction_3 a rcxn:SlotObligatory ;
    cx:WordOrder "After element 2, before element 4" ;
    olia:hasSemanticRole olia:RecipientRole .

cx:arzCai_Ditransitiveconstruction_4 a rcxn:SlotObligatory ;
    cx:WordOrder "After elements 2 and 3" ;
    olia:hasSemanticRole olia:ThemeRole .

cx:arzCai_Ditransitiveconstruction_Ex_A a cx:Example ;
    cx:hasAnnotatedText "[Leyla]1 [iddit]2 [Ḫālid]3 [il-kitāb]4. " ;
    cx:hasGlosses "Leyla give.3SGF.PERF Ḫālid the-book " ;
    cx:hasText "Leyla iddit Ḫālid il-kitāb. " ;
    cx:hasTranslation "Leyla gave Ḫālid the book. " .

cx:arzCai_Ditransitiveconstruction_Ex_B a cx:Example ;
    cx:hasAnnotatedText "[warrēt]2 [is-suwwāḥ]3 [il-matḥaf]4. " ;
    cx:hasGlosses "show.1SG.PERF the-tourists the-museum " ;
    cx:hasText "warrēt is-suwwāḥ il-matḥaf. " ;
    cx:hasTranslation "I showed the tourists the museum. " .

cx:arzCai_Ditransitiveconstruction_Ex_C a cx:Example ;
    cx:hasAnnotatedText "[fahhimtī]2-[ha]3 [il-muškila]4?" ;
    cx:hasGlosses "explain.2SGF.PERF-OBJ.3SGF the-problem" ;
    cx:hasText "fahhimtī-ha il-muškila?" ;
    cx:hasTranslation "Did you explain the problem to her?" .

