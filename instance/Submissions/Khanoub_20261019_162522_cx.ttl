cx:eng_alotofPLUSNconstruction_1 a rcxn:SlotObligatory ;
    cx:WordOrder "Precedes Element 2" ;
    RDFS:comment "Fixed article forming part of the complex quantifier a lot of" ;
    rcxn:hasSlotForm cx:eng_alotofPLUSNconstruction_1_Form ;
    rcxn:hasSyntacticFunction "Determiner" .

