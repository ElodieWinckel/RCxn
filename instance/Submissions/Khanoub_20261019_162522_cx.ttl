    rcxn:hasSurfaceForm "a" ;
    rcxn:hasSyntacticForm cx:eng_Indefinitearticle .

cx:eng_alotofPLUSNconstruction_2 a rcxn:SlotObligatory ;
    cx:WordOrder "Follows element 1 and precedes element 3" ;
    RDFS:comment "Historically a lexical noun, lot forms part of a grammaticalized quantifier in this construction. Its earlier source meaning is no longer central to the quantificational reading" ;
    rcxn:hasSlotForm cx:eng_alotofPLUSNconstruction_2_Form ;
    rcxn:hasSyntacticFunction "Noun-derived component of the complex binominal quantifier" .

cx:eng_alotofPLUSNconstruction_2_Form a rcxn:SlotForm ;
    rcxn:hasPhonology "lot" ;
    rcxn:hasStem cx:eng_lot ;
    rcxn:hasSyntacticForm cx:eng_Noun .

cx:eng_alotofPLUSNconstruction_3 a rcxn:SlotObligatory ;
    cx:WordOrder "Follows element 2 and precedes element 4" ;
    RDFS:comment "Fixed linking element connecting the complex quantifier to the quantified nominal expression" ;
    rcxn:hasSlotForm cx:eng_alotofPLUSNconstruction_3_Form ;
    rcxn:hasSyntacticFunction "Partitive" .

cx:eng_alotofPLUSNconstruction_3_Form a rcxn:SlotForm ;
