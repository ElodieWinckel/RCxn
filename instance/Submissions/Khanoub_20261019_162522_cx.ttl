    rcxn:hasSyntacticForm cx:eng_Preposition .

cx:eng_alotofPLUSNconstruction_4 a rcxn:SlotObligatory ;
    cx:WordOrder "Follows element 3" ;
    RDFS:comment "Open nominal slot that can be filled by plural count nouns, mass nouns, or pronouns. Internal modification is permitted, e.g., a lot of difficult questions" ;
    rcxn:hasOtherSemanticContribution "Identifies the entities being quantified." ;
    rcxn:hasSemanticProperty "Plural count, mass, or pronominal referent" ;
    rcxn:hasSlotForm cx:eng_alotofPLUSNconstruction_4_Form ;
    rcxn:hasSyntacticFunction "Quantified nominal expression" .

cx:eng_alotofPLUSNconstruction_4_Form a rcxn:SlotForm ;
    rcxn:hasSyntacticForm cx:eng_NounPhrase .

cx:eng_alotofPLUSNconstruction_Ex_A a cx:Example ;
    cx:hasAnnotatedText "[A]1 [lot]2 [of]3 [them]4 had purchased a site for a town ..." ;
    cx:hasText "A lot of them had purchased a site for a town ..." ;
    RDFS:comment "ARCHER, 1863 (Text_ID: 1863twn__x6a)." , "The quantifier takes a pronominal complement." .

cx:eng_alotofPLUSNconstruction_Ex_B a cx:Example ;
    cx:hasAnnotatedText "“When I make a word do [a]1 [lot]2 [of]3 [work]4 like that,” said Humpty Dumpty, ..." ;
    cx:hasText "“When I make a word do a lot of work like that,” said Humpty Dumpty, ..." ;
    RDFS:comment "CLMET, 1871. Lewis Carroll, Through the Looking-Glass (Text_ID: CLMET3_1_3_222)." , "Quantification of a mass noun." .

cx:eng_alotofPLUSNconstruction_Ex_C a cx:Example ;
    cx:hasAnnotatedText "In New York, [a]1 [lot]2 [of]3 [people]4 brought great big family Bibles that they could hardly carry." ;
    cx:hasText "In New York, a lot of people brought great big family Bibles that they could hardly carry." ;
    RDFS:comment "ARCHER, 1958. Billy Graham, Christ's Answer to the World (Text_ID: 1958grah_h8a)." , "Quantification of a plural count noun referring to people." .

