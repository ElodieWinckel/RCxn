cx:engEME_TheFVIconstruction_1 a rcxn:SlotObligatory ;
    cx:WordOrder "Element one is phrase-initial, only in main clauses." ;
    rcxn:hasOtherSemanticContribution "Location" , "Direction (Path)" , "Instrument" , "Manner" , "Temporal" ;
    rcxn:hasSlotForm cx:engEME_TheFVIconstruction_1_Form ;
    rcxn:hasIS rcxn:Background .

cx:engEME_TheFVIconstruction_1_Form a rcxn:SlotForm ;
    rcxn:hasSyntacticForm cx:eng_AdjectivePhrase,
        cx:eng_AdverbPhrase,
        cx:eng_NounPhrase,
        cx:eng_PrepositionalPhrase .

cx:engEME_TheFVIconstruction_2 a rcxn:SlotObligatory ;
    cx:WordOrder "Element 2 can have some distance from element 1 but always appears after it." ;
    cx:hasIndex cx:engEME_TheFVIconstruction_2_Index ;
    rcxn:hasSlotForm cx:engEME_TheFVIconstruction_2_Form ;
    rcxn:hasSyntacticFunction "Full Verb" .

cx:engEME_TheFVIconstruction_2_Form a rcxn:SlotForm ;
    rcxn:hasSyntacticForm cx:eng_Verb .

cx:engEME_TheFVIconstruction_2_Index a cx:Event ;
    olia:hasTense "absolute present and past" , "no tenses that require auxiliaries" .

cx:engEME_TheFVIconstruction_3 a rcxn:SlotObligatory ;
    cx:WordOrder "Element three comes after element 2, not necessarily immediately after." ;
    rcxn:hasOtherSemanticContribution "theme" , "agent" , "target" ;
    rcxn:hasSlotForm cx:engEME_TheFVIconstruction_3_Form ;
    rcxn:hasSyntacticFunction "Subject" ;
    rcxn:hasIS rcxn:Focus .

cx:engEME_TheFVIconstruction_3_Form a rcxn:SlotForm ;
    rcxn:hasSyntacticForm cx:eng_NounPhrase .

cx:engEME_TheFVIconstruction_Ex_A a cx:Example ;
    cx:hasAnnotatedText "But [at the dore]1 [were set]2 [Musketeres]3 to guarde the place" ;
    cx:hasText "But at the dore were set Musketeres to guarde the place" ;
    RDFS:comment "Even though here we have an auxiliary 'were' because of passivization, it remains an example of FVI since the full verb (set) is also before 3" .

cx:engEME_TheFVIconstruction_Ex_B a cx:Example ;
    cx:hasAnnotatedText "[In the last place]1 [go]2 [the Preficae or the Women]3 ..." ;
    cx:hasText "In the last place go the Preficae or the Women ..." .

cx:engEME_TheFVIconstruction_MD a rcxn:Metadata ;
