@prefix RDFS: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix cx: <http://example.org/cx/> .
@prefix dcmitype: <http://purl.org/dc/dcmitype/> .
@prefix dcterm: <http://purl.org/dc/terms/> .
@prefix lg: <https://bdlweb.phil.uni-erlangen.de/RCxn/ontologies/lg#> .
@prefix membr: <https://bdlweb.phil.uni-erlangen.de/RCxn/Abox/membr#> .
@prefix olia: <http://purl.org/olia/olia.owl#> .
@prefix rcxn: <https://bdlweb.phil.uni-erlangen.de/RCxn/ontologies/rcxn#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rsrch: <https://bdlweb.phil.uni-erlangen.de/RCxn/ontologies/rsrch#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

membr:Project_Weigelt rsrch:hasFindings membr:Project_Weigelt_F2610211337 .

cx:deuStdHigh_losingressiveconstruction a rcxn:Construction ;
    cx:hasExample cx:deuStdHigh_losingressiveconstruction_Ex_A,
        cx:deuStdHigh_losingressiveconstruction_Ex_B,
        cx:deuStdHigh_losingressiveconstruction_Ex_C ;
    lg:partOfLanguage lg:deuStdHigh ;
    rcxn:hasConstructionMeaning cx:deuStdHigh_losingressiveconstruction_Meaning ;
    rcxn:hasMetadata cx:deuStdHigh_losingressiveconstruction_MD ;
    rcxn:hasSlots cx:deuStdHigh_losingressiveconstruction_slots ;
    rcxn:hasTitle "los-ingressive-construction" .

cx:deuStdHigh_losingressiveconstruction_1 a rcxn:SlotObligatory ;
    cx:hasIndex cx:deuStdHigh_losingressiveconstruction_1_Index ;
    rcxn:hasSemanticProperty "AGENS-role" ;
    rcxn:hasSlotForm cx:deuStdHigh_losingressiveconstruction_1_Form .

cx:deuStdHigh_losingressiveconstruction_1_Form a rcxn:SlotForm ;
    rcxn:hasSurfaceForm "[AGENS]" .

cx:deuStdHigh_losingressiveconstruction_1_Index a cx:Individual ;
    olia:hasAnimacy olia:Animate .

cx:deuStdHigh_losingressiveconstruction_2 a rcxn:SlotObligatory ;
    rdfs:comment "begin-indicating particle" ;
    rdfs:comment "prefix-like type: losVINF, morphologically seperated type: losgeVINF, loszuVINF, syntactically seperated type VFin ... los" ;
    rcxn:hasOtherSemanticContribution "ingressive aspect" ;
    rcxn:hasSemanticProperty "adds ingressive aspect to the base verb" ;
    rcxn:hasSlotForm cx:deuStdHigh_losingressiveconstruction_2_Form .

cx:deuStdHigh_losingressiveconstruction_2_Form a rcxn:SlotForm ;
    rcxn:hasSurfaceForm "los" .

cx:deuStdHigh_losingressiveconstruction_3 a rcxn:SlotObligatory ;
    rcxn:hasSemanticProperty "prefers activity verbs (esp. verbs of movement or uttering sounds), states are only possible if they also fall in the category of progression verbs (e.g. (los)dampfen, (los)regnen, but not *loswissen), some achievements and semelfactives; accomplishments are blocked" ;
    rcxn:hasSlotForm cx:deuStdHigh_losingressiveconstruction_3_Form .

cx:deuStdHigh_losingressiveconstruction_3_Form a rcxn:SlotForm ;
    rcxn:hasSyntacticForm cx:deu_Verb .

cx:deuStdHigh_losingressiveconstruction_Ex_A a cx:Example ;
    cx:hasAnnotatedText "Danach [fährt]3 [sie]1 [los]2 und überlässt Collins seinem Schicksal. (Wikipedia-Korpus, Wissenschaft, 12.09.2025)" ;
    cx:hasText "Danach fährt sie los und überlässt Collins seinem Schicksal. (Wikipedia-Korpus, Wissenschaft, 12.09.2025)" ;
    cx:hasTranslation "Afterwards, she begins to drive (begins to move through the action of driving) and leaves Collins to his fate." ;
    cx:hasGlosses "Afterwards drives she los(=begin indicating particle) and leaves Collins his fate." ;
    RDFS:comment "example for the syntactically seperated type" .

cx:deuStdHigh_losingressiveconstruction_Ex_B a cx:Example ;
    cx:hasAnnotatedText "[Ich]1 saß dort, wie erstarrt, und wollte am liebsten [los]2[weinen]3. (FAZ-Korpus, Zeitung, 19.02.2025)" ;
    cx:hasText "Ich saß dort, wie erstarrt, und wollte am liebsten losweinen. (FAZ-Korpus, Zeitung, 19.02.2025)" ;
    cx:hasTranslation "I sat there, like frozen, and preferably wanted to start to cry." ;
    cx:hasGlosses "I sat there, like frozen, and wanted preferably los(=ingressive particle)cry." ;
    RDFS:comment "example for the univerbated/prefix-like type" .

cx:deuStdHigh_losingressiveconstruction_Ex_C a cx:Example ;
    cx:hasAnnotatedText "Denn auch außerhalb des Musikprogramms findet ständig [jemand]1 einen Anlass, plötzlich [loszu]2[singen]3. (Tagesspiegel-Korpus, Zeitung, 13.10.2022)" ;
    cx:hasText "Denn auch außerhalb des Musikprogramms findet ständig jemand einen Anlass, plötzlich loszusingen. (Tagesspiegel-Korpus, Zeitung, 13.10.2022)" ;
    cx:hasTranslation "Because even outside of the music programme, somebody regularly finds a reason to suddenly start to sing." ;
    cx:hasGlosses "Because even outside the music programme, finds regularly somebody a reason suddenly los(=ingressive particle)-to-sing." ;
    RDFS:comment "example for the morphologically seperated type" .

cx:deuStdHigh_losingressiveconstruction_MD a rcxn:Metadata ;
    dcterm:created "2026-10-21"^^xsd:date ;
    dcterm:references cx:deuStdHigh_losingressiveconstruction_Sources ;
    rcxn:annotator membr:Weigelt .

cx:deuStdHigh_losingressiveconstruction_Meaning a rcxn:ConstructionMeaning ;
    rcxn:hasMeaning """[AGENS]1 begins to [V]3""" .

cx:deuStdHigh_losingressiveconstruction_Sources a dcmitype:Collection .

cx:deuStdHigh_losingressiveconstruction_slots a rdf:Seq ;
    rdf:_1 cx:deuStdHigh_losingressiveconstruction_1 ;
    rdf:_2 cx:deuStdHigh_losingressiveconstruction_2 ;
    rdf:_3 cx:deuStdHigh_losingressiveconstruction_3 .

membr:Project_Weigelt_F2610211337 a rsrch:Finding ;
    RDFS:label "Attaching {los} to a base verb marks ingressive aspect in Present Day German. {los} has marked ingressive aspect in base verbs since Early New High German. The construction further marks agentiveness, and requires an AGENS as argument role. The Argument Structure is monovalent/intransitive." ;
    rsrch:basedOn cx:deuStdHigh_losingressiveconstruction .

