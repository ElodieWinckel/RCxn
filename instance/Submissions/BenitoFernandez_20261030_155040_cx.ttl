cx:spa_Decirquotativeconstruction_Ex_A a cx:Example ;
    cx:hasAnnotatedText "[Mi hermana]1 [me]2 [dice]3: [\"prepárate que así el cielo blanco y oscuro va a estar todo el año.\"]5" ;
    cx:hasGlosses "My sister to me says get ready because the sky’s going to be white and dark all year round" ;
    cx:hasText "Mi hermana me dice: \"prepárate que así el cielo blanco y oscuro va a estar todo el año.\"" ;
    cx:hasTranslation "My sister tells me, \"Get ready, because the sky’s going to be white and dark all year round.\"" .

cx:spa_Decirquotativeconstruction_Ex_B a cx:Example ;
    cx:hasAnnotatedText "[Le]2 [digo]3 [a mi esposo]4: [\"yo llego al hospital, ahí te veo.\"]5" ;
    cx:hasGlosses "to.him say to my husband 'll get to the hospital I'll see you there" ;
    cx:hasText "Le digo a mi esposo: \"yo llego al hospital, ahí te veo.\"" ;
    cx:hasTranslation "I tell my husband: ‘I'll get to the hospital, I'll see you there.’" .

cx:spa_Decirquotativeconstruction_Ex_C a cx:Example ;
    cx:hasAnnotatedText "Encontré una ginecóloga que habla español y entonces [dije]3: [\"yo voy con la que habla español.\"]5" ;
    cx:hasText "Encontré una ginecóloga que habla español y entonces dije: \"yo voy con la que habla español.\"" ;
    cx:hasTranslation "I found a gynaecologist who speaks Spanish so I thought, ‘I’ll go to the one who speaks Spanish.’" ;
    cx:hasTransliteration "Found a gynaecologist who speaks Spanish so say I’ll go to the one who speaks Spanish." .

cx:spa_Decirquotativeconstruction_Ex_D a cx:Example ;
    cx:hasAnnotatedText "[Me]2 [dijeron]3: [\"Número de placa\"]5" ;
    cx:hasGlosses "to.me say number of plate" ;
    cx:hasText "Me dijeron: \"Número de placa\"" ;
    cx:hasTranslation "They said, \"Plate number\"" .

