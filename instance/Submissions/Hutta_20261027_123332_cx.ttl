cx:deu_Toechter_Ex_F a cx:Example ;
    cx:hasAnnotatedText "D[ö]2ch" ;
    cx:hasText "D[öch]1" ;
    cx:hasTranslation "Daughters" ;
    RDFS:comment "Note: this example shows morphological reduction, a process, where plural is formed through removing parts of the singular form (here: -ter).", "Lower Saxony, Zwirner Corpus: ZW--_S_04875 (speaker), ZW--_E_04728_SE_01_T_01_DF_01 (recording)" .

