    rcxn:hasTitle "Phrase" ;
    lg:partOfLanguage lg:eng .

membr:Project_Ramezani rsrch:hasFindings membr:Project_Ramezani_250214_F250218 .

membr:Project_Ramezani_250214_F250218 a rsrch:Finding ;
    rdfs:label "So far we have results from LLM analysis that can significantly recognize and differentiate between argument structure constructions." ;
    rsrch:basedOn cx:engLME_Argumentstructureconstruction .

