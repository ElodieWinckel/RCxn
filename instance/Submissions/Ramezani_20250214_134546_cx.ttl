cx:engLME_Argumentstructureconstruction a rcxn:Construction ;
    rcxn:hasConstructionMeaning cx:engLME_Argumentstructureconstruction_Meaning ;
    rcxn:hasMetadata cx:engLME_Argumentstructureconstruction_MD ;
    rcxn:hasSlots cx:engLME_Argumentstructureconstruction_slots ;
    rcxn:hasTitle "Argument structure construction" ;
    links:inheritedBy cx:eng_CauseMotionconstruction,
        cx:engLME_Ditransitiveconstruction,
        cx:engLME_Resultativeconstruction,
        cx:engLME_Transitiveconstruction ;
    lg:partOfLanguage lg:engLME ;
    RDFS:comment """The main data includes 2000 sentences that are generated by GPT-4, which is a text file.\r
The extension data includes a representation of these data in LLM and brain, \r
Representation in LLMs are matrixes including hidden layer activity and attention factor.\r
The representation in the brain includes EEG recordings from 10 participants while listening to 200 of these sentences.\r
Both are matrixes in the format of NumPy arrays but can be converted to any supporting format.\r
\r
This is a similar publicly available dataset: https://github.com/SPOClab-ca/neural-reality-constructions\r
""" .

cx:engLME_Argumentstructureconstruction_1 a rcxn:SlotObligatory ;
    rcxn:hasSlotForm cx:engLME_Argumentstructureconstruction_1_Form ;
    rcxn:hasSyntacticFunction "Subject" .

cx:engLME_Argumentstructureconstruction_1_Form a rcxn:SlotForm ;
    rcxn:hasSyntacticForm cx:eng_Phrase .

cx:engLME_Argumentstructureconstruction_2 a rcxn:SlotObligatory ;
    rcxn:hasSlotForm cx:engLME_Argumentstructureconstruction_2_Form .

cx:engLME_Argumentstructureconstruction_2_Form a rcxn:SlotForm ;
    rcxn:hasSyntacticForm cx:eng_Verb .

cx:engLME_Argumentstructureconstruction_3 a rcxn:SlotObligatory ;
    rcxn:hasSlotForm cx:engLME_Argumentstructureconstruction_3_Form ;
    rcxn:hasSyntacticFunction "Complement(s)" .

cx:engLME_Argumentstructureconstruction_3_Form a rcxn:SlotForm ;
    rcxn:hasSyntacticForm cx:eng_Phrase ;
    RDFS:comment "one or several Phrases" .

cx:engLME_Argumentstructureconstruction_MD a rcxn:Metadata ;
    rcxn:annotator membr:Ramezani ;
    dcterm:created "2025-02-14"^^xsd:date ;
    cx:hasSources cx:engLME_Argumentstructureconstruction_Sources .

cx:engLME_Argumentstructureconstruction_Meaning a rcxn:ConstructionMeaning ;
    rcxn:hasMeaning """The central senses of argument structure construction have been argued to be in association with humanly relevant scenes like: transferring [something]3 to [someone]3, causing [something]3 to change state or move, experiencing [something,]3 [something]1 undergoing a change of state or location""" .

cx:engLME_Argumentstructureconstruction_slots a rdf:Seq ;
    rdf:_1 cx:engLME_Argumentstructureconstruction_1 ;
    rdf:_2 cx:engLME_Argumentstructureconstruction_2 ;
    rdf:_3 cx:engLME_Argumentstructureconstruction_3 .

