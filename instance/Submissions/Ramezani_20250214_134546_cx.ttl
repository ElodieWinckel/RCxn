cx:engLME_Argumentstructureconstruction_Sources a dcmitype:Collection ;
    dcterm:hasPart references:08c9d8b7-af8413-45e16f-746e5f49b3f9-1 ,
    references:08c9d8b7-af8413-45e16f-746e5f49b3f9-2 ,
