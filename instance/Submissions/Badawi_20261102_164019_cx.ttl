membr:Project_Badawi rsrch:hasResearchQuestion membr:Project_Badawi_2611021640 .

cx:engLME_EarnConstruction a rcxn:Construction ;
    cx:hasExample cx:engLME_EarnConstruction_Ex_A,
        cx:engLME_EarnConstruction_Ex_B,
        cx:engLME_EarnConstruction_Ex_C ;
    lg:partOfLanguage lg:engLME ;
    rcxn:hasConstructionMeaning cx:engLME_EarnConstruction_Meaning ;
    rcxn:hasMetadata cx:engLME_EarnConstruction_MD ;
    rcxn:hasSlots cx:engLME_EarnConstruction_slots ;
    rcxn:hasTitle "Earn Construction" .

cx:engLME_EarnConstruction_1 a rcxn:SlotOptional ;
    rcxn:hasOtherSemanticContribution "ÆFFECTOR" ;
    rcxn:hasSyntacticFunction "Subject" .

cx:engLME_EarnConstruction_2 a rcxn:SlotObligatory ;
    cx:WordOrder "Element 2 follows Element 1" ;
    rcxn:hasSlotForm cx:engLME_EarnConstruction_2_Form .

cx:engLME_EarnConstruction_2_Form a rcxn:SlotForm ;
    rcxn:hasSyntacticForm cx:eng_earn .

cx:engLME_EarnConstruction_3 a rcxn:SlotObligatory ;
    cx:WordOrder "Element 3 follows Element 2" ;
    rcxn:hasOtherSemanticContribution "ÆFFECTED" ;
    rcxn:hasSyntacticFunction "Direct Object" .

cx:engLME_EarnConstruction_Ex_A a cx:Example ;
    cx:hasAnnotatedText "Presumably [the ships]1 [earn]2 [money]3 by carrying cargoes, doing the ordinary. ( H0D 2490 )" ;
    cx:hasText "Presumably the ships earn money by carrying cargoes, doing the ordinary. ( H0D 2490 )" ;
    RDFS:comment "The AEFFECTOR is inanimate (ships), and the by-phrase expresses the work for which the return is obtained" .

cx:engLME_EarnConstruction_Ex_B a cx:Example ;
    cx:hasAnnotatedText "It’s tough to get into the union, and it’s tough to [earn]2 [a living]3 in the profession. ( A06 1525 )" ;
    cx:hasText "It’s tough to get into the union, and it’s tough to earn a living in the profession. ( A06 1525 )" ;
    RDFS:comment "living is the strongest object collexeme of earn. Non-finite use with an implicit AEFFECTOR." .

cx:engLME_EarnConstruction_Ex_C a cx:Example ;
    cx:hasAnnotatedText "[I]1 have worked very hard in this hospital to [earn]2 [the respect of my colleagues]3, and in one fell swoop you've managed to compromise my integrity. (JYB 1989)" ;
    cx:hasText "I have worked very hard in this hospital to earn the respect of my colleagues, and in one fell swoop you've managed to compromise my integrity. (JYB 1989)" ;
    RDFS:comment "The preceding clause (worked very hard) states the effort for which the respect is the deserved return; the AEFFECTOR I is the understood subject of the infinitive." .

cx:engLME_EarnConstruction_MD a rcxn:Metadata ;
    dcterm:created "2026-11-02"^^xsd:date ;
    dcterm:references cx:engLME_EarnConstruction_Sources ;
    rcxn:annotator membr:Badawi .

cx:engLME_EarnConstruction_Meaning a rcxn:ConstructionMeaning ;
    rcxn:hasMeaning "1. [An Affector]1 obtains [an Affected]3 as a deserved return for its own work, effort or behaviour." ,
        "2. [An Affector]1 obtains [money or a means of subsistence]3 in return for work." ,
        "3. [An Affector]1 obtains [a status or a positive evaluation]3 in return for its behaviour or achievements." .

cx:engLME_EarnConstruction_Sources a dcmitype:Collection ;
    dcterm:hasPart references:34c997b5-ef0f-4a6b-9acb-63f34659318d,
