membr:Project_Badawi rsrch:hasResearchQuestion membr:Project_Badawi_2611021640 .

cx:eng_EarnConstruction a rcxn:Construction ;
    cx:hasExample cx:eng_EarnConstruction_Ex_A,
        cx:eng_EarnConstruction_Ex_B,
        cx:eng_EarnConstruction_Ex_C ;
    lg:partOfLanguage lg:eng ;
    rcxn:hasConstructionMeaning cx:eng_EarnConstruction_Meaning ;
    rcxn:hasMetadata cx:eng_EarnConstruction_MD ;
    rcxn:hasSlots cx:eng_EarnConstruction_slots ;
    rcxn:hasTitle "Earn Construction" .

cx:eng_EarnConstruction_1 a rcxn:SlotOptional ;
    rcxn:hasOtherSemanticContribution "ÆFFECTOR" ;
    rcxn:hasSyntacticFunction "Subject" .

cx:eng_EarnConstruction_2 a rcxn:SlotObligatory ;
    cx:WordOrder "Element 2 follows Element 1" .

cx:eng_EarnConstruction_3 a rcxn:SlotOptional ;
    cx:WordOrder "Element 3 follows Element 2 when the verb is used as ditransitive" ;
    rcxn:hasOtherSemanticContribution "RECIPIENT" ;
    rcxn:hasSyntacticFunction "Indirect Object" .

cx:eng_EarnConstruction_4 a rcxn:SlotObligatory ;
    cx:WordOrder "Element 4 follows Element 3 ,but when Element 3 is not present then Element 4 follows Element 2" ;
    rcxn:hasOtherSemanticContribution "ÆFFECTED" ;
    rcxn:hasSyntacticFunction "Direct Object" .

cx:eng_EarnConstruction_Ex_A a cx:Example ;
    cx:hasAnnotatedText "Presumably [the ships]1 [earn]2 [money]4 by carrying cargoes, doing the ordinary. ( H0D 2490 )" ;
    cx:hasText "Presumably the ships earn money by carrying cargoes, doing the ordinary. ( H0D 2490 )" ;
    RDFS:comment "The AEFFECTOR is inanimate (ships), and the by-phrase expresses the work for which the return is obtained" .

cx:eng_EarnConstruction_Ex_B a cx:Example ;
    cx:hasAnnotatedText "It’s tough to get into the union, and it’s tough to [earn]2 [a living]4 in the profession. ( A06 1525 )" ;
    cx:hasText "It’s tough to get into the union, and it’s tough to earn a living in the profession. ( A06 1525 )" ;
    RDFS:comment "living is the strongest object collexeme of earn. Non-finite use with an implicit AEFFECTOR." .

cx:eng_EarnConstruction_Ex_C a cx:Example ;
    cx:hasAnnotatedText "[Revelations about his string of dancing partners and unsuitable friends]1 might have [earned]2 [him]3 [a reputation]4 not unlike Fergie’. (CEK 1093 ). " ;
    cx:hasText "Revelations about his string of dancing partners and unsuitable friends might have earned him a reputation not unlike Fergie’. (CEK 1093 )s. " ;
    RDFS:comment "Ditransitive variant. The nominal AEFFECTOR is the behaviour that brings the status about, the pronoun him is the RECIPIENT, and the reputation obtained is a negative one." .

cx:eng_EarnConstruction_MD a rcxn:Metadata ;
    dcterm:created "2026-11-02"^^xsd:date ;
    dcterm:references cx:eng_EarnConstruction_Sources ;
    rcxn:annotator membr:Badawi .

cx:eng_EarnConstruction_Meaning a rcxn:ConstructionMeaning ;
    rcxn:hasMeaning "1. [An Affector]1 obtains [an Affected]4 as a deserved return for its own work, effort or behaviour." ,
        "2. [An Affector]1 obtains [money or a means of subsistence]4 in return for work." ,
        "3. [An Affector]1 obtains [a status or a positive evaluation]4 in return for its behaviour or achievements." .

cx:eng_EarnConstruction_Sources a dcmitype:Collection ;
    dcterm:hasPart references:34c997b5-ef0f-4a6b-9acb-63f34659318d,
        references:3e049438-dc56-4ccf-81f4-ca59b7f455cd,
        references:46ceab2b-78ca-4369-b397-1f4cfc77b173,
