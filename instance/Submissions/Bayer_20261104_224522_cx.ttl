    rdf:_4 cx:arzCai_Prepositionaldativeconstruction_4 .

membr:Project_Bayer_2611042245_F2611042245 a rsrch:Finding ;
    RDFS:label "The prepositional dative construction is used for ditransitive verbs if the recipient is expressed by a full NP, while the theme is pronominal or if both arguments are pronominal. The ditransitive construction cannot be used in these cases. In other constellations the constructions alternate." ;
    rsrch:basedOn cx:arzCai_Prepositionaldativeconstruction .

membr:Bayer foaf:currentProject membr:Project_Bayer_2611042245 .

membr:Project_Bayer_2611042245 a rsrch:Project ;
    rsrch:hasFindings membr:Project_Bayer_2611042245_F2611042245 ;
    rsrch:projectName "In which constellations of the theme's and the recipient's individuation properties is this construction used?" .

cx:arzCai_Prepositionaldativeconstruction a rcxn:Construction ;
    lg:partOfLanguage lg:arzCai ;
    links:similarFormSimilarFunction cx:arzCai_Dativeconstruction,
        cx:arzCai_Ditransitiveconstruction ;
    rcxn:hasConstructionMeaning cx:arzCai_Prepositionaldativeconstruction_Meaning ;
    rcxn:hasMetadata cx:arzCai_Prepositionaldativeconstruction_MD ;
    rcxn:hasSlots cx:arzCai_Prepositionaldativeconstruction_slots ;
    rcxn:hasTitle "Prepositional dative construction" .

