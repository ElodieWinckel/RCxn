cx:arzCai_Prepositionaldativeconstruction_Meaning a rcxn:ConstructionMeaning ;
    rcxn:hasMeaning "[Agent]1 causes [theme]4 to move to [recipient]3" .

cx:arzCai_Prepositionaldativeconstruction_Sources a dcmitype:Collection .

cx:arzCai_Prepositionaldativeconstruction_slots a rdf:Seq ;
