    dcterm:created "2026-11-04"^^xsd:date ;
    rcxn:annotator membr:Bayer .

cx:arzCai_Ditransitiveconstruction links:similarFormSimilarFunction cx:arzCai_Prepositionaldativeconstruction .

cx:arzCai_Prepositionaldativeconstruction_1 a rcxn:SlotOptional ;
    cx:WordOrder "Before element 2" ;
    olia:hasSemanticRole olia:AgentRole .

cx:arzCai_Prepositionaldativeconstruction_2 a rcxn:SlotObligatory ;
    cx:WordOrder "After element 2, before elements 3 and 4" ;
    RDFS:comment "colloprofile: idda; ʿallim; nāwil; massik; sallif; labbis; sallim; ḥammil; darris; šammim; fahhim; ḥaffaẓ; nassa; ballaġ; saʾal; fahhim; malla; warra; ḫassaṛ; ġaṛṛam; ʾallaʿ" .

cx:arzCai_Prepositionaldativeconstruction_3 a rcxn:SlotObligatory ;
    cx:WordOrder "After element 4" ;
    olia:hasSemanticRole olia:RecipientRole .

cx:arzCai_Prepositionaldativeconstruction_4 a rcxn:SlotObligatory ;
    cx:WordOrder "After element 2, before element 3" ;
    olia:hasSemanticRole olia:ThemeRole .

