membr:Project_Bayer rsrch:hasResearchQuestion membr:Project_Bayer_2611042245 .

cx:arzCai_Dativeconstruction a rcxn:Construction ;
    links:similarFormSimilarFunction cx:arzCai_Prepositionaldativeconstruction ;
    rcxn:hasMetadata cx:arzCai_Dativeconstruction_MD ;
    rcxn:hasTitle "Dative construction" .

