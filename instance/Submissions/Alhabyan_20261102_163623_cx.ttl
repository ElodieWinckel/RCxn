cx:araCla_ComitativeConstruction a rcxn:Construction ;
    cx:hasExample cx:araCla_ComitativeConstruction_Ex_A,
        cx:araCla_ComitativeConstruction_Ex_B,
        cx:araCla_ComitativeConstruction_Ex_C,
        cx:araCla_ComitativeConstruction_Ex_D ;
    lg:partOfLanguage lg:araCla ;
    rcxn:hasConstructionMeaning cx:araCla_ComitativeConstruction_Meaning ;
    rcxn:hasMetadata cx:araCla_ComitativeConstruction_MD ;
    rcxn:hasSlots cx:araCla_ComitativeConstruction_slots ;
    rcxn:hasTitle "Comitative Construction" .

cx:araCla_ComitativeConstruction_1 a rcxn:SlotObligatory ;
    cx:WordOrder "First element" ;
    rcxn:hasSemanticProperty "Verbs denoting directed motion" ;
    RDFS:comment "collocolloprofile: ǧāʾa 'to arrive'; ʾatā 'to come'; ḏahaba 'to leave'; daẖala 'to enter'; ẖaraǧa 'to go out'; marra 'to pass by' (ambiguous); ǧarā 'to move in specified course'; sāra 'to walk'; nazala 'to descend'; mašā 'to walk'; ʾinṭalaqa 'to rush'; ʾasrā 'to travel by night', etc. " ;
    rcxn:hasSyntacticFunction "Verb" .

cx:araCla_ComitativeConstruction_2 a rcxn:SlotOptional ;
    cx:WordOrder "After Element 1" ;
    cx:hasIndex cx:araCla_ComitativeConstruction_2_Index ;
    olia:hasCase olia:Nominative ;
    olia:hasSemanticRole olia:AgentRole ;
    rcxn:hasSyntacticFunction "Subject " .

cx:araCla_ComitativeConstruction_2_Index a cx:Individual ;
    olia:hasAnimacy olia:Human .

cx:araCla_ComitativeConstruction_3 a rcxn:SlotObligatory ;
    cx:WordOrder "after Element 2, bound to Element 4" ;
    olia:hasSemanticRole olia:ComitativeRole ;
    rcxn:hasSlotForm cx:araCla_ComitativeConstruction_3_Form ;
    rcxn:hasSyntacticFunction "Preposition " .

cx:araCla_ComitativeConstruction_3_Form a rcxn:SlotForm ;
    rcxn:hasPhonology "/bi/" ;
    rcxn:hasSurfaceForm "bi-" .

cx:araCla_ComitativeConstruction_4 a rcxn:SlotObligatory ;
    cx:WordOrder "after Element 3" ;
    cx:hasIndex cx:araCla_ComitativeConstruction_4_Index ;
    olia:hasCase olia:GenitiveCase ;
    olia:hasSemanticRole olia:PatientRole ;
    rcxn:hasSemanticProperty "[NP] must not denote or refer to time/location nor to abstract concept ~ entails change of meaning" ;
    rcxn:hasSyntacticFunction "Oblique" .

cx:araCla_ComitativeConstruction_4_Index a cx:Individual ;
    olia:hasAnimacy "Can be +/- animate, +/- human" .

cx:araCla_ComitativeConstruction_Ex_A a cx:Example ;
    cx:hasAnnotatedText "وَسَارَ بِأَهْلِهِ" ;
    cx:hasTransliteration "wa-[sāra]1 [bi-]3[ʾahli-hī]4" ;
    cx:hasGlosses "walk.3SGM.PERF with- housefolk.GEN-3SGM" ;
    cx:hasText "وَسَارَ بِأَهْلِهِ" ;
    cx:hasTranslation "He [Moses] was traveling with his housefolk" ;
    RDFS:comment "Source: Quran 28:29" .

cx:araCla_ComitativeConstruction_Ex_B a cx:Example ;
    cx:hasAnnotatedText "فَأْتُوا بِسُورَةٍ مِّن مِّثْلِهِ" ;
    cx:hasTransliteration "fa-[ʾt]1[ū]2 [bi-]3[sūratin]4 min miṯli-hī" ;
    cx:hasGlosses "come.2PLM.IMP with- chapter.GEN" ;
    cx:hasText "فَأْتُوا بِسُورَةٍ مِّن مِّثْلِهِ" ;
    cx:hasTranslation "Produce a surah (chapter)." ;
    RDFS:comment "Source: Quran 2:23" .

cx:araCla_ComitativeConstruction_Ex_C a cx:Example ;
    cx:hasAnnotatedText "ذَهَبَ اللَّهُ بِنُورِهِمْ" ;
    cx:hasTransliteration "[ḏahaba]1 [llāhu]2 [bi-]3[nūri-him]4" ;
    cx:hasGlosses "go.2SGM.PERF God with- light.GEN-3PLM" ;
    cx:hasText "ذَهَبَ اللَّهُ بِنُورِهِمْ" ;
    cx:hasTranslation "God taketh away their light " ;
    RDFS:comment "Source: Quran 2:17" .

cx:araCla_ComitativeConstruction_Ex_D a cx:Example ;
    cx:hasAnnotatedText "فَ[أْتُ]1[وا]2 [بِ]3[سُورَةٍ]4ْ" ;
    cx:hasTranslation "فَأْتُوا بِسُورَةٍْ" ;
    RDFS:comment "test" .

