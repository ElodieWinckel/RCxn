@prefix RDFS: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix cx: <http://example.org/cx/> .
@prefix dcmitype: <http://purl.org/dc/dcmitype/> .
@prefix dcterm: <http://purl.org/dc/terms/> .
@prefix lg: <https://bdlweb.phil.uni-erlangen.de/RCxn/ontologies/lg#> .
@prefix membr: <https://bdlweb.phil.uni-erlangen.de/RCxn/Abox/membr#> .
@prefix olia: <http://purl.org/olia/olia.owl#> .
@prefix rcxn: <https://bdlweb.phil.uni-erlangen.de/RCxn/ontologies/rcxn#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rsrch: <https://bdlweb.phil.uni-erlangen.de/RCxn/ontologies/rsrch#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

membr:Project_Weigelt rsrch:hasFindings membr:Project_Weigelt_F2611111011 .

cx:deuNHD_erresultativeconstruction a rcxn:Construction ;
    cx:hasExample cx:deuNHD_erresultativeconstruction_Ex_A,
        cx:deuNHD_erresultativeconstruction_Ex_B,
        cx:deuNHD_erresultativeconstruction_Ex_C ;
    lg:partOfLanguage lg:deuNHD ;
    rcxn:hasConstructionMeaning cx:deuNHD_erresultativeconstruction_Meaning ;
    rcxn:hasMetadata cx:deuNHD_erresultativeconstruction_MD ;
    rcxn:hasSlots cx:deuNHD_erresultativeconstruction_slots ;
    rcxn:hasTitle "er-resultative-construction" .

cx:deuNHD_erresultativeconstruction_1 a rcxn:SlotObligatory ;
    cx:hasIndex cx:deuNHD_erresultativeconstruction_1_Index ;
    olia:hasSemanticRole olia:AgentRole .

cx:deuNHD_erresultativeconstruction_1_Index a cx:Individual ;
    olia:hasAnimacy olia:Animate .

cx:deuNHD_erresultativeconstruction_2 a rcxn:SlotObligatory ;
    cx:WordOrder "Element 2 necessarily attaches on the left hand side to Element 3." ;
    rcxn:hasOtherSemanticContribution "resultative aspect" ;
    rcxn:hasSlotForm cx:deuNHD_erresultativeconstruction_2_Form .

cx:deuNHD_erresultativeconstruction_2_Form a rcxn:SlotForm ;
    rcxn:hasSurfaceForm "er-" .

cx:deuNHD_erresultativeconstruction_3 a rcxn:SlotObligatory ;
    cx:WordOrder "Element 3 needs Element 2 attached to it on the left hand side" ;
    rcxn:hasSemanticProperty "There is a strong tendency to recruit activity verbs into the base verb slot of the er-resultative-cxn. However, all semantic verbal classes can form the base verb (therefore: also states, achievements, accomplishments, and semelfactives)." ;
    rcxn:hasSlotForm cx:deuNHD_erresultativeconstruction_3_Form .

cx:deuNHD_erresultativeconstruction_3_Form a rcxn:SlotForm ;
    rcxn:hasSyntacticForm cx:deu_Verb .

cx:deuNHD_erresultativeconstruction_4 a rcxn:SlotObligatory ;
    rcxn:hasOtherSemanticContribution "result" ;
    rcxn:hasSlotForm cx:deuNHD_erresultativeconstruction_4_Form .

cx:deuNHD_erresultativeconstruction_5 a rcxn:SlotOptional ;
    olia:hasSemanticRole olia:BenefactorRole ;
    RDFS:comment "In most cases, AGENT and BENEFACTIVE are the same entity. If this fact is specifically focused on, this slot is filled by a reflexive pronoun." ;
    rcxn:hasSlotForm cx:deuNHD_erresultativeconstruction_5_Form .

cx:deuNHD_erresultativeconstruction_Ex_A a cx:Example ;
    cx:hasAnnotatedText "Außerdem [er]2[lief]3 [sie]1 in Changchun [Silber im Teamsprint und Gold im Massenstart]4. (Wikipedia-Korpus, Wissenschaft, 29.12.2025)" ;
    cx:hasGlosses "Also, (er-)ran she in Changchun silver in the team sprint and gold in the mass start." ;
    cx:hasText "Außerdem erlief sie in Changchun Silber im Teamsprint und Gold im Massenstart. (Wikipedia-Korpus, Wissenschaft, 29.12.2025)" ;
    cx:hasTranslation "Also, she (er-)ran as long as necessary to receive silver in the team sprint event and gold in the mass start event." ;
    RDFS:comment "Example for the variant without a specified benefactive. Sie in the example sentence refers to Ayano Satō in context." .

cx:deuNHD_erresultativeconstruction_Ex_B a cx:Example ;
    cx:hasAnnotatedText "Siebzig Meter vor dem Ziel zog Bryshina dann doch vorbei und [(Bryshina)]1 [er]2[lief]3 [für ihre Mannschaft]5 [den Olympiasieg]4 vor den USA. (Wikipedia-Korpus, Wissenschaft, 09.04.2024)" ;
    cx:hasGlosses "Seventy metres before the finish line, passed Bryshina then still by and (Bryshina) (er-)ran for her team the olympic victory before the US." ;
    cx:hasText "Siebzig Meter vor dem Ziel zog Bryshina dann doch vorbei und (Bryshina) erlief für ihre Mannschaft den Olympiasieg vor den USA. (Wikipedia-Korpus, Wissenschaft, 09.04.2024)" ;
    cx:hasTranslation "Seventy metres before the finish line, Bryshina still managed to pass by and (Bryshina) received the olympic victory through running for her team before the US." ;
    RDFS:comment "Example for the variant with a specified benefactive that is not the agent at the same time. Bryshina is omitted in the original sentence after the und." .

cx:deuNHD_erresultativeconstruction_Ex_C a cx:Example ;
    cx:hasAnnotatedText "[800-m-Olympiasieger Nils Schumann]1 […] [er]2[lief]3 [sich]5 auf der schneebedeckten Strecke mit 34:37 Minuten [den fünften Rang]4[.] (bz-Korpus, Zeitung, 02.01.2001)" ;
    cx:hasGlosses "800-m-olympia-victor Nils Schumann […] (er-)ran himself on the snow-covered track with 34:35 minutes the fifth rang." ;
    cx:hasText "800-m-Olympiasieger Nils Schumann […] erlief sich auf der schneebedeckten Strecke mit 34:37 Minuten den fünften Rang[.] (bz-Korpus, Zeitung, 02.01.2001)" ;
    cx:hasTranslation "Nils Schumann, olympic victor on 800m, ran on the snow-covered track until he received the fifth rang for himself with 34:35 minutes." ;
    RDFS:comment "Example for the case when benefactive and the agent are the same entity, and this fact is focused on. The reflexive pronoun sich therefore fills the benefactive slot." .

cx:deuNHD_erresultativeconstruction_MD a rcxn:Metadata ;
    dcterm:created "2026-11-11"^^xsd:date ;
    dcterm:references cx:deuNHD_erresultativeconstruction_Sources ;
    rcxn:annotator membr:Weigelt .

cx:deuNHD_erresultativeconstruction_Meaning a rcxn:ConstructionMeaning ;
    rcxn:hasMeaning "[AGENT]1 [er-]2[V]3 to receive [RESULT]4 (for [BENEFACTIVE]5)" .

cx:deuNHD_erresultativeconstruction_Sources a dcmitype:Collection .

cx:deuNHD_erresultativeconstruction_slots a rdf:Seq ;
    rdf:_1 cx:deuNHD_erresultativeconstruction_1 ;
    rdf:_2 cx:deuNHD_erresultativeconstruction_2 ;
    rdf:_3 cx:deuNHD_erresultativeconstruction_3 ;
    rdf:_4 cx:deuNHD_erresultativeconstruction_4 ;
    rdf:_5 cx:deuNHD_erresultativeconstruction_5 .

membr:Project_Weigelt_F2611111011 a rsrch:Finding ;
    RDFS:label "In combination with an AGENT and a RESULT, {er-} marks resultative aspect in Present Day German verbs. The construction can also take on a facultative BENEFACTIVE. If AGENT and BENEFACTIVE are the same entity, and this fact is specifically focused on, the BENEFACTIVE slot is filled by a reflexive pronoun." ;
    rsrch:basedOn cx:deuNHD_erresultativeconstruction .

