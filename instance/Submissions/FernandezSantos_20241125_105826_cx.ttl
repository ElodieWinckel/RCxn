    rdf:_1 cx:spaSpoPen_Potentiallyambiguousobjectrelativeclause_1 ;
    rdf:_2 cx:spaSpoPen_Potentiallyambiguousobjectrelativeclause_2 ;
    rdf:_3 cx:spaSpoPen_Potentiallyambiguousobjectrelativeclause_3 ;
