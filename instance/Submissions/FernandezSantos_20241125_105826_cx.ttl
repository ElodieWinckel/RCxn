cx:spaSpoPen_Potentiallyambiguousobjectrelativeclause_1 a rcxn:SlotObligatory ;
    rcxn:hasSlotForm cx:spaSpoPen_Potentiallyambiguousobjectrelativeclause_1_Form ;
    rcxn:hasSyntacticFunction "Object (within the clause)" ;
    cx:hasIndex cx:spaSpoPen_Potentiallyambiguousobjectrelativeclause_1_Index .

cx:spaSpoPen_Potentiallyambiguousobjectrelativeclause_1_Form a rcxn:SlotForm ;
    rcxn:hasSyntacticForm cx:spa_NounPhrase .

cx:spaSpoPen_Potentiallyambiguousobjectrelativeclause_1_Index a cx:Individual ;
    olia:hasAnimacy olia:Animate ;
    olia:hasNumber olia:Singular ;
    olia:hasGender "[1]" .

cx:spaSpoPen_Potentiallyambiguousobjectrelativeclause_2 a rcxn:SlotOptional ;
    cx:WordOrder "If present, Element 2 immediately after Element 1" ;
    rcxn:hasSlotForm cx:spaSpoPen_Potentiallyambiguousobjectrelativeclause_2_Form ;
    cx:hasTranslation "to:the" ;
    rcxn:hasSyntacticFunction "direct object marker" .

cx:spaSpoPen_Potentiallyambiguousobjectrelativeclause_2_Form a rcxn:SlotForm ;
    rcxn:hasSyntacticForm cx:spa_aPLUSarticle .

cx:spaSpoPen_Potentiallyambiguousobjectrelativeclause_3 a rcxn:SlotObligatory ;
    cx:WordOrder "immediately after Element 1 (if Element 2 not present), or immediately after Element 2 if present" ;
    rcxn:hasSlotForm cx:spaSpoPen_Potentiallyambiguousobjectrelativeclause_3_Form ;
    cx:hasTranslation "that" .

cx:spaSpoPen_Potentiallyambiguousobjectrelativeclause_3_Form a rcxn:SlotForm ;
    rcxn:hasSurfaceForm "que" ;
    rcxn:hasSyntacticForm cx:spa_Relativizer .

cx:spaSpoPen_Potentiallyambiguousobjectrelativeclause_4 a rcxn:SlotObligatory ;
    cx:WordOrder "Immediately after Element 3" ;
    rcxn:hasSlotForm cx:spaSpoPen_Potentiallyambiguousobjectrelativeclause_4_Form ;
    rcxn:hasSyntacticFunction "subject (within the clause)" ;
    cx:hasIndex cx:spaSpoPen_Potentiallyambiguousobjectrelativeclause_4_Index .

cx:spaSpoPen_Potentiallyambiguousobjectrelativeclause_4_Form a rcxn:SlotForm ;
    rcxn:hasSyntacticForm cx:spa_NounPhrase .

cx:spaSpoPen_Potentiallyambiguousobjectrelativeclause_4_Index a cx:Individual ;
    olia:hasAnimacy olia:Animate ;
    olia:hasNumber olia:Singular ;
    olia:hasGender "[1]" .

cx:spaSpoPen_Potentiallyambiguousobjectrelativeclause_5 a rcxn:SlotObligatory ;
    cx:WordOrder "immediately after Element 4" ;
    rcxn:hasSlotForm cx:spaSpoPen_Potentiallyambiguousobjectrelativeclause_5_Form ;
    cx:hasIndex cx:spaSpoPen_Potentiallyambiguousobjectrelativeclause_5_Index ;
    rdfs:comment "1st conjugation verb" .

cx:spaSpoPen_Potentiallyambiguousobjectrelativeclause_5_Form a rcxn:SlotForm ;
    rcxn:hasSyntacticForm cx:spa_Verb .

cx:spaSpoPen_Potentiallyambiguousobjectrelativeclause_5_Index a cx:Event ;
