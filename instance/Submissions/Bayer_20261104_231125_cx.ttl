    dcterm:created "2026-11-04"^^xsd:date ;
    rcxn:annotator membr:Bayer .

cx:arzCai_Dativeconstruction_1 a rcxn:SlotOptional ;
    cx:WordOrder "Before element 2" ;
    olia:hasSemanticRole olia:AgentRole .

cx:arzCai_Dativeconstruction_2 a rcxn:SlotObligatory ;
    cx:WordOrder "After element 2, before elements 3 and 4" ;
    RDFS:comment "colloprofile: idda; ʿallim; nāwil; massik; sallif; labbis; sallim; ḥammil; darris; šammim; fahhim; ḥaffaẓ; nassa; ballaġ; saʾal; fahhim; malla; warra; ḫassaṛ; ġaṛṛam; ʾallaʿ" .

cx:arzCai_Dativeconstruction_3 a rcxn:SlotObligatory ;
    cx:WordOrder "After element 2, before element 4" ;
    olia:hasSemanticRole olia:RecipientRole .

cx:arzCai_Dativeconstruction_4 a rcxn:SlotObligatory ;
    cx:WordOrder "After elements 2 and 3" ;
    olia:hasSemanticRole olia:ThemeRole .

cx:arzCai_Dativeconstruction_Ex_A a cx:Example ;
    cx:hasAnnotatedText "[Leyla]1 [iddit]2 [li-Ḫālid]3 [il-kitāb]4. " ;
    cx:hasGlosses "Leyla give.3SGF.PERF DAT-Ḫālid the-book " ;
    cx:hasText "Leyla iddit li-Ḫālid il-kitāb. " ;
    cx:hasTranslation "Leyla gave Ḫālid the book. " .

cx:arzCai_Dativeconstruction_Ex_B a cx:Example ;
    cx:hasAnnotatedText "[warrēt]2 [li-s-suwwāḥ]3 [il-matḥaf]4. " ;
    cx:hasGlosses "show.1SG.PERF DAT-the-tourists the-museum " ;
    cx:hasText "warrēt li-s-suwwāḥ il-matḥaf. " ;
    cx:hasTranslation "I showed the tourists the museum. " .

cx:arzCai_Dativeconstruction_Ex_C a cx:Example ;
    cx:hasAnnotatedText "[labbist]2-[il-hum]3 [il-hidūm il-gidīda]4" ;
    cx:hasGlosses "dress.1SG.PERF-DAT-3PL the-clothes the-new" ;
    cx:hasText "labbist-il-hum il-hidūm il-gidīda" ;
    cx:hasTranslation "I dressed them in the new clothes" .

