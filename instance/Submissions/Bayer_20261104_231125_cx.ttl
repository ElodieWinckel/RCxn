cx:arzCai_Ditransitiveconstruction links:similarFormSameFunction cx:arzCai_Dativeconstruction .

membr:Project_Bayer_2611042311_F2611042311 a rsrch:Finding ;
    RDFS:label "The dative construction alternates with the prepositional dative construction and the ditransitive construction if the recipient is nominal or pronominal and the theme is expressed by a full NP." ;
    rsrch:basedOn cx:arzCai_Dativeconstruction .

membr:Bayer foaf:currentProject membr:Project_Bayer_2611042311 .

membr:Project_Bayer_2611042311 a rsrch:Project ;
    rsrch:hasFindings membr:Project_Bayer_2611042311_F2611042311 ;
    rsrch:projectName "In which constellations of the theme's and the recipient's individuation properties is this construction used?" .

