membr:Project_Khanoub rsrch:hasResearchQuestion membr:Project_Khanoub_2610141629 .

cx:eng_many a rcxn:Construction ;
    lg:partOfLanguage lg:eng ;
    links:elementOf cx:eng_manyPLUSNcountCx ;
    rcxn:hasMetadata cx:eng_many_MD ;
    rcxn:hasTitle "many" .

cx:eng_manyPLUSNcountCx_1 a rcxn:SlotObligatory ;
    cx:WordOrder "Precedes Element 2" ;
    RDFS:comment "Lexically fixed quantifier selecting a plural count-noun expression" ;
    rcxn:hasOtherSemanticContribution "Indefinite cardinal quantification" ;
    rcxn:hasSemanticProperty "Specifies a contextually large, indefinite number of entities" ;
    rcxn:hasSlotForm cx:eng_manyPLUSNcountCx_1_Form ;
    rcxn:hasSyntacticFunction "quantifier" .

cx:eng_manyPLUSNcountCx_1_Form a rcxn:SlotForm ;
    rcxn:hasPhonology "/ˈmen.i/" ;
    rcxn:hasStem cx:eng_many ;
    rcxn:hasSurfaceForm "many" .

cx:eng_manyPLUSNcountCx_2 a rcxn:SlotOptional ;
    cx:WordOrder "follows element 1" ;
    RDFS:comment "Open nominal slot headed by a plural count noun; permits internal modification, e.g., many difficult questions" ;
    rcxn:hasSemanticProperty "Countable referent" ;
    rcxn:hasSyntacticFunction "Quantified nominal expression" .

cx:eng_manyPLUSNcountCx_Ex_A a cx:Example ;
    cx:hasAnnotatedText "I might give [many]1 [reasons]2 to satisfy others." ;
    cx:hasText "I might give many reasons to satisfy others." ;
    RDFS:comment "EEBO, 1614. Thomas Adams, The deuills banket (Text_ID: A00888).", "Direct quantification of a plural count noun denoting abstract entities." .

cx:eng_manyPLUSNcountCx_Ex_B a cx:Example ;
    cx:hasAnnotatedText "He had lived [many]1 [years]2 in England, and he held an excellent position in society." ;
    cx:hasText "He had lived many years in England, and he held an excellent position in society." ;
    RDFS:comment "CLMET, 1874 (Text_ID: CLMET3_1_3_203)." , "The construction quantifies a plural count noun denoting temporal units. The example illustrates the use of MANY with nouns from the TIME semantic domain." .

cx:eng_manyPLUSNcountCx_Ex_C a cx:Example ;
    cx:hasAnnotatedText "There were [many]1 [insignificant sums]2 to individuals ..." ;
    cx:hasText "There were many insignificant sums to individuals ..." ;
    RDFS:comment "ARCHER, 1902. Arthur Conan Doyle, The Hound of the Baskervilles (Text_ID: 1902doyl_f7b)." , "The quantified plural count-noun expression includes an adjectival premodifier, illustrating internal nominal modification." .

