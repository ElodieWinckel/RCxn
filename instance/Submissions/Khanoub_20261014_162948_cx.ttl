    dcterm:created "2026-10-14"^^xsd:date ;
    dcterm:references cx:eng_manyPLUSNcountCx_Sources ;
    rcxn:annotator membr:Khanoub .

cx:eng_manyPLUSNcountCx_Meaning a rcxn:ConstructionMeaning ;
    rcxn:hasMeaning "High quantity of [X(thing)]2: The construction expresses a contextually large, unspecified number of [entities denoted by a plural count-noun expression]2. \n [The quantifier]1 many indicates cardinal quantity, while the [nominal element]2 identifies what is being quantified." .

